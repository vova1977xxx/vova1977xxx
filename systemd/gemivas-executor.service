[Unit]
Description=GEMIVAS Executor (JSON-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/executor
ExecStart=/srv/executor/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 9001
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
