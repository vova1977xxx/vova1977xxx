[Unit]
Description=GEMIVAS Brain Sources Loop (CANON)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/gemivas-platform
ExecStart=/srv/ai_core/orchestrator/venv/bin/python /srv/gemivas-platform/workers_queue/brain_sources_loop.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
